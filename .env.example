# College Study Portal — environment configuration template
#
# Copy this file to `.env` and adjust for your machine. In development everything
# is optional; only SESSION_SECRET is required when NODE_ENV=production.
#
# The application does NOT auto-load .env files. Export these variables in your
# shell (PowerShell:  $env:NAME="value" ) or use a process manager that does.

# --- Server ------------------------------------------------------------
# HTTP port (default 3000)
PORT=3000

# "production" enables Secure cookies, HSTS and strict secret handling.
# Leave unset in development.
# NODE_ENV=production

# --- Session -----------------------------------------------------------
# Secret used to sign session cookies. Required in production (>= 32 chars).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Session lifetime in hours (default 168 = 7 days)
SESSION_HOURS=168

# Set to "1" when running behind a reverse proxy (nginx, IIS, etc.) so rate
# limiting sees real client IPs instead of the proxy's address.
# TRUST_PROXY=1

# --- Storage -----------------------------------------------------------
# Location of the SQLite database (default ./portal.db)
# DB_PATH=./portal.db

# Where uploaded study material is stored (default ./uploads)
# UPLOADS_DIR=./uploads

# --- Security logging --------------------------------------------------
# Set to "1" to ALSO write security events to logs/security.log (they always
# go to stdout).
# SECURITY_LOG_FILE=1

# --- Testing only ------------------------------------------------------
# These exist for the automated suites and should NOT be set in normal use.

# Raise the /api/auth rate limit so a test run can exercise login behaviour.
# AUTH_RATE_LIMIT_OVERRIDE=200

# A teacher account the security suite can sign in with to verify the
# authenticated page checks.
# SECURITY_TEST_EMAIL=you@college.edu
# SECURITY_TEST_PASSWORD=Your#Password

# --- StudyFlow v2 (Oracle + JWT stack) -----------------------------------
# Copy to .env for the v2 stack (server_studyflow_v2.js / seed_oracle.js).
#
# Secret used to sign JWTs. REQUIRED in production; in development a random
# ephemeral secret is generated per boot (tokens are invalidated on restart).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=
#
# Oracle Autonomous Database credentials (download the wallet from OCI and
# point TNS_ADMIN at the unzipped folder; the connect string matches the
# tnsnames.ora service name, e.g. studyflow_high).
# ORACLE_USER=ADMIN
# ORACLE_PASSWORD=YourPassword123#
# ORACLE_CONNECT_STRING=studyflow_high
# TNS_ADMIN=./wallet
#
# Raise the /api/auth rate limit for automated test runs only.
# AUTH_RATE_LIMIT_OVERRIDE=200
