{
  "name": "college-study-portal",
  "version": "1.0.0",
  "description": "College Study Portal - Teacher & Student Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "start:v2": "node server_studyflow_v2.js",
    "seed:oracle": "node seed_oracle.js",
    "start:prod": "npm run build:frontend && node start_prod.js",
    "build:frontend": "npm --prefix react-frontend run build",
