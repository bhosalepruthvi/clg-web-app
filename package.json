    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.17.3",
    "helmet": "^8.3.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "oracledb": "^26.0.0"
  }
